.DEFAULT_GOAL := all
.SUFFIXES:
ifeq ($(strip $(DEVKITPRO)),)
$(error Set DEVKITPRO to the devkitPro root)
endif
DEVKITARM ?= $(DEVKITPRO)/devkitARM
include $(DEVKITARM)/3ds_rules
export PATH := $(DEVKITPRO)/tools/bin:$(PATH)
PROBE_NAME ?= FilmProbe
PROBE_BUILD ?= build-probe
PROBE_EXTRA_FLAGS ?=
export PROBE_NAME PROBE_BUILD PROBE_EXTRA_FLAGS
APP_TITLE := $(PROBE_NAME)
APP_DESCRIPTION := Camera register and exposure experiments
APP_AUTHOR := Film3DS
ARCH := -march=armv6k -mtune=mpcore -mfpu=vfp -mfloat-abi=hard -mtp=soft
CFLAGS = -std=gnu11 -O2 -g -Wall -Wextra -Werror -mword-relocations -ffunction-sections -fdata-sections $(ARCH) $(INCLUDE) $(PROBE_EXTRA_FLAGS) -D__3DS__ -DPROBE_REVISION='"$(REVISION)"'
LDFLAGS = -specs=3dsx.specs $(ARCH) -Wl,--gc-sections,-Map,$(OUTPUT).map
LIBS := -lz -lctru -lm
LD := $(CC)
ifneq ($(notdir $(CURDIR)),$(PROBE_BUILD))
export TOPDIR := $(CURDIR)
export OUTPUT := $(CURDIR)/$(PROBE_NAME)
export REVISION := 5a1e62d-calibration2
export INCLUDE := -I$(CTRULIB)/include -I$(DEVKITPRO)/portlibs/3ds/include
export LIBPATHS := -L$(CTRULIB)/lib -L$(DEVKITPRO)/portlibs/3ds/lib
export OFILES := main.o
export VPATH := $(CURDIR)/probes/exposure
export DEPSDIR := $(CURDIR)/$(PROBE_BUILD)
.PHONY: all
all:
	@mkdir -p $(PROBE_BUILD)
	$(MAKE) --no-print-directory -C $(PROBE_BUILD) -f $(TOPDIR)/Makefile.probe
else
_3DSXFLAGS := --smdh=$(OUTPUT).smdh
all: $(OUTPUT).3dsx
$(OUTPUT).3dsx: $(OUTPUT).elf $(OUTPUT).smdh
$(OUTPUT).elf: $(OFILES)
-include $(OFILES:.o=.d)
endif
